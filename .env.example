# Ollama Local GPU LLM Configuration
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen3:latest

# Brain Mode: "rule" (pure deterministic offline), "ollama" (local GPU), or "claude"
BRAIN_MODE=ollama

# Anthropic Claude API Key (optional, for cloud evaluation)
# ANTHROPIC_API_KEY=your_key_here

# Trial Limits (Enforced by LimitGuard)
MAX_RUNS=2
MAX_ROUNDS=2

# Default as-of date for simulated clock
DEFAULT_AS_OF=2027-01-25
